# Salin ke .env.local untuk pengembangan lokal.

# Kunci penanda tangan sesi, minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Lokal: berkas SQLite. Produksi (Vercel): isi TURSO_DATABASE_URL dan
# TURSO_AUTH_TOKEN (otomatis terisi bila memakai integrasi Turso di Vercel).
DATABASE_URL=file:local.db
# TURSO_DATABASE_URL=libsql://nama-db-anda.turso.io
# TURSO_AUTH_TOKEN=

# Opsional. Bila diisi, pendaftaran meminta kode ini, sehingga hanya orang yang
# Anda beri kode yang bisa mendaftar. Kosongkan untuk pendaftaran terbuka.
REGISTRATION_CODE=
